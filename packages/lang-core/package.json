{
  "name": "@startlang/lang-core",
  "private": true,
  "type": "module",
  "exports": {
    "./diagnostics": "./src/diagnostics.ts",
    "./editor-model": "./src/editor-model.ts",
    "./interpreter": "./src/interpreter.ts",
    "./parser.peggy": "./src/parser.peggy",
    "./program": "./src/program.ts",
    "./runtime-history": "./src/runtime-history.ts",
    "./runtime-globals": "./src/runtime-globals.ts",
    "./types": "./src/types.ts",
    "./nodes": "./src/nodes/index.ts",
    "./nodes/*": "./src/nodes/*.ts",
    "./handlers/*": "./src/handlers/*.ts",
    "./builtins/types": "./src/builtins/types.ts",
    "./utils/*": "./src/utils/*.ts"
  },
  "scripts": {
    "lint": "eslint src tools",
    "repl": "tsx --import ./tools/hooks.js ./tools/repl.ts",
    "script": "tsx --import ./tools/hooks.js ./tools/script.ts",
    "test": "vitest run",
    "typecheck": "tsgo --noEmit"
  },
  "dependencies": {
    "deep-equal": "^2.2.3",
    "immer": "^11.1.7"
  },
  "devDependencies": {
    "@types/deep-equal": "^1.0.4"
  }
